# ── Core ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT=inner-world-map        # какой продукт обслуживает этот деплой
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=                 # только сервер, НИКОГДА в клиент

# ── AI ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
REPLICATE_API_TOKEN=                       # опц. (Flux)

# ── Queue / cache (Upstash) ──────────────────────────
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Payments (Paddle Billing) ────────────────────────
# Sandbox-ключи на staging, live-ключи на production.
PADDLE_API_KEY=                            # для server-side создания транзакции (опц.)
PADDLE_WEBHOOK_SECRET=                     # секрет уведомлений (для verify подписи)
PADDLE_ENV=sandbox                         # sandbox | production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=           # client-side токен Paddle.js
NEXT_PUBLIC_PADDLE_PRICE_ID=               # price_xxx из Paddle для этого продукта

# ── Email (Resend) ───────────────────────────────────
RESEND_API_KEY=
RESEND_FROM="MienApps <noreply@yourdomain.app>"

# ── Internal ─────────────────────────────────────────
CRON_SECRET=                               # защита /api/cron/cleanup

# ── Observability ────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
